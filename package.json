{
  "name": "function-location",
  "version": "1.0.0",
  "description": "Retrieve `[[FunctionLocation]]` from V8.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/loader.js",
    "dist/loader.d.ts",
    "dist/locate.node",
    "dist/locate-win.node"
  ],
  "scripts": {
    "build:all": "npm run build && npm run build:native",
    "build": "tsc",
    "build:native": "node ./build-native",
    "copy:native": "node ./scripts/copy-native-addon.js",
    "verify:pack": "node ./scripts/verify-pack-tarball.js",
    "pretest": "npm run build:all",
    "prepack": "npm run build:all && npm run verify:pack",
    "test": "jest"
  },
  "keywords": [
    "[[FunctionLocation]]",
    "function",
    "class",
    "path",
    "location",
    "locateV8",
    "locate"
  ],
  "author": "Nhahan",
  "license": "MIT",
  "homepage": "https://github.com/Nhahan/function-location",
  "devDependencies": {
    "node-gyp": "^12.2.0",
    "@types/jest": "^29.5.3",
    "babel-jest": "^29.6.4",
    "jest": "^29.6.2",
    "typescript": "^5.1.6",
    "ts-jest": "^29.1.1"
  }
}
