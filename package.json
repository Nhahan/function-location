{
  "name": "function-location",
  "version": "1.0.0",
  "description": "Retrieve `[[FunctionLocation]]` from V8.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/loader.js",
    "dist/loader.d.ts",
    "prebuilds/**"
  ],
  "scripts": {
    "build:all": "npm run build && npm run build:native",
    "build": "tsc",
    "build:native": "node ./scripts/build-native.js",
    "install": "node-gyp-build",
    "prebuild": "node ./scripts/prebuild.js",
    "verify:prebuild": "node ./scripts/verify-prebuild.js",
    "verify:prebuild:coverage": "node ./scripts/verify-prebuild-coverage.js",
    "verify:pack": "node ./scripts/verify-pack-tarball.js",
    "release:branch-check": "node ./scripts/verify-release-branch.js",
    "release:merge-prebuilds": "node ./scripts/merge-prebuild-artifacts.js",
    "release:prepare": "npm run build:all && npm run verify:pack",
    "release:prepare:ci": "npm run build && npm run verify:pack",
    "prepack": "npm run build:all && npm run prebuild && npm run verify:pack",
    "test": "node ./scripts/run-tests.js",
    "bench:compare": "node ./scripts/benchmark-comparison.js"
  },
  "keywords": [
    "[[FunctionLocation]]",
    "function",
    "class",
    "path",
    "location",
    "locateV8",
    "locate"
  ],
  "author": "Nhahan",
  "license": "MIT",
  "homepage": "https://github.com/Nhahan/function-location",
  "engines": {
    "node": ">=8 <25"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "babel-jest": "^29.6.4",
    "jest": "^29.6.2",
    "node-gyp": "^12.2.0",
    "prebuildify": "^6.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  }
}
